# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local Database & User Uploads
data/*.db
data/*.db-wal
data/*.db-shm
data/uploads/*
!data/uploads/.gitkeep
!data/uploads/policies
data/uploads/policies/*
!data/uploads/policies/.gitkeep
data/outputs/*
!data/outputs/.gitkeep

# Operating System files
Thumbs.db
[Dd]esktop.ini
.DS_Store

# IDE & Editor caches
.vscode/
.idea/
*.swp
*.swo

# Environment variables
.env
.env.local
